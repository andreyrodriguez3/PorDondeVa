# PostgreSQL connection string used by the api container and by `prisma` commands run locally.
DATABASE_URL=postgresql://tubus:tubus@localhost:5432/tubus?schema=public

# Token signing secrets. Generate with `openssl rand -hex 32`. Never reuse between environments.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Base domain company subdomains are matched against, e.g. tuanrl.<PLATFORM_DOMAIN>.
PLATFORM_DOMAIN=tubus.localhost

# Hostname that serves the admin dashboard exclusively (D5 — never a customer-controlled host).
ADMIN_HOST=admin.tubus.localhost

# Browser-facing endpoints for the web app.
PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# MapLibre style URL. The tile provider is swappable via this single variable (CODESTYLE §A12).
# OpenFreeMap's hosted "liberty" style: free, no API key, full street/building/label detail.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Raw GPS point retention, in days.
LOCATION_RETENTION_DAYS=90

# A trip with no incoming point for this many minutes is auto-completed.
TRIP_AUTO_END_MINUTES=90

# Logging.
LOG_LEVEL=info

# Rate limiting (requests per window, window in seconds), applied to auth and public endpoints.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# API port (host side of the api container).
API_PORT=8080

# Where company logos are stored. A mounted volume in production; a local folder here.
UPLOADS_DIR=./uploads

# Production only (docker-compose.prod.yml) — the Postgres password Caddy/api/migrate
# use to reach the database container. Not read in local development.
POSTGRES_PASSWORD=change-me-in-production
